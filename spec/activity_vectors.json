{
  "description": "Discord Activity build vectors shared by the macOS (Swift) and Windows (Rust) builds. See spec/README.md.",
  "cases": [
    {
      "name": "playing without a catalog drops the song button and keeps the repository one",
      "track": {
        "name": "Song",
        "artist": "Artist",
        "album": "Album",
        "durationSec": 200,
        "positionSec": 50,
        "positionSampledAtUnix": 1700000000
      },
      "playerState": "playing",
      "catalog": null,
      "settings": {},
      "nowUnix": 1700000000,
      "expected": {
        "type": 2,
        "details": "Song",
        "state": "Artist",
        "status_display_type": 1,
        "timestamps": {
          "start": 1699999950000,
          "end": 1700000150000
        },
        "buttons": [
          {
            "label": "About This App",
            "url": "https://github.com/Narcissus-tazetta/Ceyrad"
          }
        ]
      }
    },
